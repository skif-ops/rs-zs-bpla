{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dioneya.local/schemas/dioneya.alert.1.schema.json",
  "title": "dioneya.alert/1",
  "description": "One message of the Dioneya output API (protocols/DIONEYA_ALERT_API_v1.md).",
  "type": "object",
  "required": ["schema", "seq", "msg_id", "type", "tenant", "alert_id", "time", "created"],
  "properties": {
    "schema": {"const": "dioneya.alert/1"},
    "seq": {"type": "integer", "minimum": 0},
    "msg_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "type": {"enum": ["alert.start", "alert.update", "alert.end", "track.update", "track.end", "bearing", "heartbeat"]},
    "tenant": {"type": ["string", "null"]},
    "alert_id": {"type": ["string", "null"]},
    "time": {"$ref": "#/$defs/time"},
    "created": {"$ref": "#/$defs/time"},
    "alert": {"$ref": "#/$defs/alert"},
    "track": {"$ref": "#/$defs/track"},
    "bearing": {"$ref": "#/$defs/bearing"}
  },
  "additionalProperties": false,
  "oneOf": [
    {"properties": {"type": {"enum": ["alert.start", "alert.update", "alert.end"]}, "tenant": {"type": "string"}, "alert_id": {"type": "string"}},
     "required": ["alert"]},
    {"properties": {"type": {"enum": ["track.update", "track.end"]}, "tenant": {"type": "string"}, "alert_id": {"type": "string"}},
     "required": ["track"]},
    {"properties": {"type": {"const": "bearing"}, "tenant": {"type": "string"}, "alert_id": {"type": "string"}},
     "required": ["bearing"]},
    {"properties": {"type": {"const": "heartbeat"}, "alert_id": {"type": "null"}}}
  ],
  "$defs": {
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "class": {
      "type": "object",
      "required": ["code", "label", "confidence", "type", "f0_hz"],
      "properties": {
        "code": {"enum": ["uav_piston", "uav_jet", "uav_electric", "aircraft", "helicopter", "other", "unknown"]},
        "label": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "type": {"type": ["string", "null"]},
        "f0_hz": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "station": {
      "type": "object",
      "required": ["station_id", "lat", "lon", "alt_msl_m"],
      "properties": {
        "station_id": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
        "lon": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
        "alt_msl_m": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    },
    "alert": {
      "type": "object",
      "required": ["level", "started", "ended", "stations", "class", "tracks"],
      "properties": {
        "level": {"enum": ["warning", "alert"]},
        "started": {"$ref": "#/$defs/time"},
        "ended": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
        "stations": {"type": "array", "items": {"$ref": "#/$defs/station"}},
        "class": {"$ref": "#/$defs/class"},
        "tracks": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "required": ["track_id", "position", "error", "velocity", "class", "stations", "crossing_deg", "first", "points", "ended", "end_reason"],
      "properties": {
        "track_id": {"type": "string"},
        "position": {
          "type": "object",
          "required": ["lat", "lon", "alt_msl_m"],
          "properties": {
            "lat": {"type": "number", "minimum": -90, "maximum": 90},
            "lon": {"type": "number", "minimum": -180, "maximum": 180},
            "alt_msl_m": {"type": "number"}
          },
          "additionalProperties": false
        },
        "error": {
          "type": "object",
          "required": ["horizontal_m", "vertical_m"],
          "properties": {"horizontal_m": {"type": "number", "minimum": 0}, "vertical_m": {"type": "number", "minimum": 0}},
          "additionalProperties": false
        },
        "velocity": {
          "type": "object",
          "required": ["speed_mps", "course_deg", "east_mps", "north_mps", "up_mps"],
          "properties": {
            "speed_mps": {"type": "number", "minimum": 0},
            "course_deg": {"type": "number", "minimum": 0, "maximum": 360},
            "east_mps": {"type": "number"},
            "north_mps": {"type": "number"},
            "up_mps": {"type": "number"}
          },
          "additionalProperties": false
        },
        "class": {"$ref": "#/$defs/class"},
        "stations": {"type": "array", "items": {"type": "integer"}, "minItems": 2},
        "crossing_deg": {"type": "number", "minimum": 0, "maximum": 90},
        "ambiguous": {"enum": [true, false], "description": "a station of the point hears another target it cannot tell from this one at the same time: the point may be a ghost crossing (2026-10-02, optional)"},
        "first": {"$ref": "#/$defs/time"},
        "points": {"type": "integer", "minimum": 1},
        "ended": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
        "end_reason": {"enum": ["lost", "alert_end", null]}
      },
      "additionalProperties": false
    },
    "bearing": {
      "type": "object",
      "required": ["station", "track_event_id", "azimuth_deg", "elevation_deg", "sigma_deg", "range_max_m", "class"],
      "properties": {
        "station": {"$ref": "#/$defs/station"},
        "track_event_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "azimuth_deg": {"type": "number", "minimum": 0, "maximum": 360},
        "elevation_deg": {"type": "number", "minimum": -90, "maximum": 90},
        "sigma_deg": {"type": "number", "minimum": 0},
        "range_max_m": {"type": "number", "minimum": 0},
        "class": {"$ref": "#/$defs/class"}
      },
      "additionalProperties": false
    }
  }
}
