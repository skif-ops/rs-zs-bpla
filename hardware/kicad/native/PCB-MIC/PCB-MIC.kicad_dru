(version 1)

# MK1 manufacturer copper may use the accepted 0.125 mm local minimum.
(rule "T5838 manufacturer copper clearance"
  (condition "A.memberOfFootprint('MK1') || B.memberOfFootprint('MK1')")
  (constraint clearance (min 0.125mm))
)

# Only pad 3 may use the 0.10 mm exception to the acoustic NPTH.
# Ordinary tracks and zones remain subject to the 0.20 mm project rule.
(rule "T5838 acoustic land hole clearance"
  (condition "A.Type == 'Pad' && A.memberOfFootprint('MK1') && A.Pad_Number == '3' && B.Type == 'Pad' && B.memberOfFootprint('MK1') && B.Pad_Type == 'NPTH, mechanical'")
  (constraint hole_clearance (min 0.10mm))
)
