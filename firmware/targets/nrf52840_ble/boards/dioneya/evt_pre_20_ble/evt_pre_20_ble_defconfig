# Dioneya EVT-PRE-20 BLE bridge board (U11 Raytac MDBT50Q-P1MV2). Pin authority: hardware/PCB_MAIN_BLE_PIN_AUTHORITY_REV_A.csv
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_GPIO=y
CONFIG_SERIAL=y
# P0.18 is wired as nRESET (pad 40): the reset buffer from STM32 BLE_EN drives it, so the UICR must map it as reset.
CONFIG_GPIO_AS_PINRESET=y
# No 32.768 kHz crystal fitted (XL1/XL2 NC): run the LF clock from the calibrated RC oscillator.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC_CALIBRATION=y
# The only UART (P0.06 TX / P0.08 RX) is the IPC link to the STM32: no UART console, logs over RTT via the SWD pads.
CONFIG_UART_CONSOLE=n
CONFIG_USE_SEGGER_RTT=y
CONFIG_RTT_CONSOLE=y
CONFIG_CONSOLE=y
